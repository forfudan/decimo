# ===----------------------------------------------------------------=== #
# Burnikel-Ziegler division (divisor > 64 words = > 2048 bits)
# ===----------------------------------------------------------------=== #


def test_divide_at_bz_boundary() raises:
    """Division straddling the Burnikel-Ziegler cutoff (2048 bits = 64 words).
    """
    var a0 = BigInt(
        ""
    )
    var b0 = BigInt(
        ""
    )
    testing.assert_equal(
        String(a0 // b0),
        "",
    )
    testing.assert_equal(
        String(a0 % b0),
        "",
    )
    var a1 = BigInt(
        ""
    )
    var b1 = BigInt(
        ""
    )
    testing.assert_equal(
        String(a1 // b1),
        "",
    )
    testing.assert_equal(
        String(a1 % b1),
        "",
    )
    var a2 = BigInt(
        ""
    )
    var b2 = BigInt(
        ""
    )
    testing.assert_equal(
        String(a2 // b2),
        "",
    )
    testing.assert_equal(
        String(a2 % b2),
        "",
    )


