"""
Tests `hypot` and `arctan2`, the length and the angle of a point.

The two have very different references, and the difference is worth stating.

`hypot` has an exact one. `x*x + y*y` is a rational, and whether its square
root is rational is a question about integers, so every expectation here that
can be exact is, and the rest come from a high-precision `decimal` computed
twice and kept only when both round alike.

`arctan2` has no exact oracle in reach: no arbitrary-precision library is
available here, and `decimal` has no arctangent. So it is checked three ways.
Where the ratio is near one of the axes the arctangent's series converges fast
enough to sum exactly in `fractions.Fraction`, and pi comes from Machin's
formula, whose two arctangents are small for the same reason -- that covers
all four quadrants and is where the table below comes from. Where the ratio
is in the middle, between a quarter and four, the check is a round trip
instead: the tangent of the answer is the ratio, and the signs of its sine
and cosine are the signs of the two coordinates. And the special values are
checked against IEEE 754's own table.

Two rows are kept from a comparison against CPython's `math.atan2`, which
disagreed on them. The exact series settled it: `libm` is a unit out in the
last place and these answers are correct. They are here so that a future
change cannot quietly give the wrong one back.
"""

from std import testing
from std.testing import assert_equal, assert_true

from decimo.bigfloat.arithmetics import divide, subtract
from decimo.bigfloat.bigfloat import BigFloat
from decimo.bigfloat.comparison import compare_absolute
from decimo.bigfloat.constants import pi
from decimo.bigfloat.exponential import hypot
from decimo.bigfloat.rounding import leading_bit_position
from decimo.bigfloat.trigonometric import arctan, arctan2, cos, sin, tan
from decimo.bigint.bigint import BigInt
from decimo.rounding_mode import RoundingMode


def _modes() -> List[RoundingMode]:
    """The seven modes, in the order the tables index them."""
    return [
        RoundingMode.ROUND_DOWN,
        RoundingMode.ROUND_UP,
        RoundingMode.ROUND_CEILING,
        RoundingMode.ROUND_FLOOR,
        RoundingMode.ROUND_HALF_UP,
        RoundingMode.ROUND_HALF_DOWN,
        RoundingMode.ROUND_HALF_EVEN,
    ]


def _shape(x: BigFloat) -> String:
    """A name for a special value, so a failure says which one it is."""
    if x.is_nan():
        return "NaN"
    if x.is_infinite():
        return "-Inf" if x.sign else "+Inf"
    if x.is_zero():
        return "-0" if x.sign else "+0"
    return "finite"


def _pair(
    significand: String, exponent: String, precision: String, negative: String
) raises -> BigFloat:
    """One of the two values a row carries, from four of its fields.

    Args:
        significand: The significand.
        exponent: The exponent.
        precision: The bits the significand has.
        negative: "1" for a negative value.

    Returns:
        The value.

    Raises:
        Error: Propagated from the parsing.
    """
    return BigFloat(
        significand=BigInt(significand),
        exponent=Int(exponent),
        precision=Int(precision),
        sign=negative == "1",
    )


def test_the_hypotenuse_is_what_the_reference_rounds_to() raises:
    """Seventeen pairs at four precisions in all seven modes.

    The pairs include the Pythagorean ones, where the answer is a whole
    number and no bracket around it could decide its rounding, equal legs
    where it is irrational, both signs, and legs a thousand times apart.
