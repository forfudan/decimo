        var want = String("-") if field[12] == "1" else String("")
        want += (
            String(field[10])
            + "p"
            + String(field[11])
            + "@"
            + String(destination)
        )
        assert_equal(got.internal_representation(), want, String("case ") + row)


def test_a_pythagorean_pair_is_exact_in_every_mode() raises:
    """`hypot(3, 4)` is five, and the directed modes are the test.

    The sum of the squares is formed in integers and its root taken in
    integers, so the remainder says the answer is exact. A pair of rounded
    squares and a rounded root could not say that, and the deciding loop
    could not either -- the answer sits exactly on the boundary.
    """
    var modes = _modes()
    var legs = [
        [String("3"), String("4"), String("5")],
        [String("5"), String("12"), String("13")],
        [String("8"), String("15"), String("17")],
        [String("7"), String("24"), String("25")],
        [String("9"), String("40"), String("41")],
        [String("300"), String("400"), String("500")],
        [String("-3"), String("-4"), String("5")],
    ]
    for leg in legs:
        for index in range(7):
            assert_equal(
                String(
                    hypot(
                        BigFloat.from_string(leg[0], 53),
                        BigFloat.from_string(leg[1], 53),
                        53,
                        modes[index],
                    )
                ),
                leg[2],
                leg[0] + ", " + leg[1] + " in mode " + String(index),
            )


def test_the_hypotenuse_of_a_special_value() raises:
    """An infinity wins over anything, including a NaN.

    IEEE 754 asks for that: no value of the other leg could make an infinite
    one finite, so the answer is known before the other leg is looked at.
    """
    var p = 53
    assert_equal(
        _shape(hypot(BigFloat.infinity(p, False), BigFloat.nan(p), p)),
        "+Inf",
        "an infinity against a NaN",
    )
    assert_equal(
        _shape(hypot(BigFloat.nan(p), BigFloat.infinity(p, True), p)),
        "+Inf",
        "a NaN against a negative infinity",
    )
    assert_equal(
        _shape(hypot(BigFloat.nan(p), BigFloat.from_int(1, p), p)),
        "NaN",
        "a NaN against a finite leg",
    )
    assert_equal(
        _shape(hypot(BigFloat.zero(p, True), BigFloat.zero(p, False), p)),
        "+0",
        "two noughts give a positive nought",
    )
    assert_equal(
        String(hypot(BigFloat.zero(p, True), BigFloat.from_int(-7, p), p)),
        "7",
        "a nought leg leaves the magnitude of the other",
    )


def test_a_leg_far_below_the_other() raises:
    """The answer is the larger leg moved by a hair, not the larger leg.

    Once the ratio's square is below the last place, no width would show
    where the sum sits, so the answer has to be nudged off the larger leg
    rather than returned as it is -- and which way it is nudged is the mode's
    business.
    """
    var big = BigFloat.from_string("1e300", 53)
    var small = BigFloat.from_int(1, 53)
    assert_equal(
        String(hypot(big, small, 53, RoundingMode.ROUND_DOWN))
        == String(hypot(big, small, 53, RoundingMode.ROUND_UP)),
        False,
        "the two directions differ, so the sum was not simply dropped",
    )


