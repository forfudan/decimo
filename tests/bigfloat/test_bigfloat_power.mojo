"""
Tests `BigFloat`'s power.

The reference is exact wherever the answer is. A whole exponent gives a
rational, and so does a fractional one over a base that is a perfect power,
so those expectations are computed in `fractions.Fraction` and rounded to
bits. Only the irrational answers go through a high-precision `decimal`, and
each of those is computed twice, sixty digits apart, and kept only when both
round the same way -- a decimal oracle is unstable exactly where the answer
is rational, which is the one place this function must not be wrong.

The special values are checked against IEEE 754's own table for `pow`, which
answers two cases before it looks at anything else: a nought exponent gives
one for every base, a NaN included, and a base of one gives one for every
exponent, a NaN included.
"""

from std import testing
from std.testing import assert_equal, assert_true

from decimo.bigfloat.arithmetics import multiply
from decimo.bigfloat.bigfloat import BigFloat
from decimo.bigfloat.exponential import sqrt
from decimo.bigfloat.power import power
from decimo.bigint.bigint import BigInt
from decimo.rounding_mode import RoundingMode


def _modes() -> List[RoundingMode]:
    """The seven modes, in the order the table indexes them."""
    return [
        RoundingMode.ROUND_DOWN,
        RoundingMode.ROUND_UP,
        RoundingMode.ROUND_CEILING,
        RoundingMode.ROUND_FLOOR,
        RoundingMode.ROUND_HALF_UP,
        RoundingMode.ROUND_HALF_DOWN,
        RoundingMode.ROUND_HALF_EVEN,
    ]


def _shape(x: BigFloat) -> String:
    """A name for a special value, so a failure says which one it is."""
    if x.is_nan():
        return "NaN"
    if x.is_infinite():
        return "-Inf" if x.sign else "+Inf"
    if x.is_zero():
        return "-0" if x.sign else "+0"
    return "finite"


def test_the_values_are_what_the_reference_rounds_to() raises:
    """Twenty-four pairs at four precisions in all seven modes.

    The pairs cover whole exponents of both signs, the fractional ones that
    land on an exact answer (`4 ** 0.5`, `16 ** 0.25`, `0.25 ** -0.5`), the
    ones that do not (`2 ** 0.5`, `3 ** 2.5`), and negative bases with whole
    exponents of both parities.
    """
    var modes = _modes()
    # x_significand x_exponent x_precision x_negative
    # y_significand y_exponent y_precision y_negative
    # destination mode expected_significand expected_exponent expected_negative
