        "3 -1 2 1 1 1 1 0 113 6 5841333965851681082096808370372608 -111 0",
    ]
    for row in cases:
        var field = row.split(" ")
        var x = BigFloat(
            significand=BigInt(String(field[0])),
            exponent=Int(String(field[1])),
            precision=Int(String(field[2])),
            sign=field[3] == "1",
        )
        var y = BigFloat(
            significand=BigInt(String(field[4])),
            exponent=Int(String(field[5])),
            precision=Int(String(field[6])),
            sign=field[7] == "1",
        )
        var destination = Int(String(field[8]))
        var got = power(x, y, destination, modes[Int(String(field[9]))])
        var want = String("-") if field[12] == "1" else String("")
        want += (
            String(field[10])
            + "p"
            + String(field[11])
            + "@"
            + String(destination)
        )
        assert_equal(got.internal_representation(), want, String("case ") + row)


def test_an_exact_answer_is_exact_in_every_mode() raises:
    """The answers the deciding loop could never settle on.

    A loop that brackets the true value cannot say which side of a boundary
    it falls on when it falls exactly on one, and a power lands there
    constantly: `2 ** 10` is `1024` and `4 ** 0.5` is `2`. Every mode has to
    return those, which means they have to be recognized rather than decided.
    The directed modes are the test -- half to even would settle on an
    exactly representable value by itself, because such a value is where
    half to even already rounds.
    """
    var modes = _modes()
    var pairs = [
        [String("2"), String("10"), String("1024")],
        [String("4"), String("0.5"), String("2")],
        [String("16"), String("0.25"), String("2")],
        [String("9"), String("0.5"), String("3")],
        [String("256"), String("0.125"), String("2")],
        [String("1.5"), String("3"), String("3.375")],
        [String("2"), String("-3"), String("0.125")],
        [String("0.25"), String("-0.5"), String("2")],
        [String("-2"), String("3"), String("-8")],
    ]
    for pair in pairs:
        for index in range(7):
            assert_equal(
                String(
                    power(
                        BigFloat.from_string(pair[0], 53),
                        BigFloat.from_string(pair[1], 53),
                        53,
                        modes[index],
                    )
                ),
                pair[2],
                pair[0] + " ** " + pair[1] + " in mode " + String(index),
            )


def test_a_half_agrees_with_the_square_root() raises:
    """`x ** 0.5` and `sqrt(x)` are the same number, so they must agree.

    They do not share an implementation: the root takes an integer square
    root of a scaled significand, while the power reaches the series unless
    the root comes out exact. Agreement in both is therefore worth something.
    """
    var half = BigFloat.from_string("0.5", 53)
    for text in ["2", "3", "5", "7", "10", "0.5", "1.5", "1e10", "4", "9"]:
        var x = BigFloat.from_string(text, 113)
        assert_equal(
            power(x, half, 113).internal_representation(),
            sqrt(x, 113).internal_representation(),
            String("the half power of ") + text,
        )


def test_a_small_whole_power_agrees_with_multiplying() raises:
    """`x ** 3` and `x * x * x` agree when the product is exact.

    A significand of a few bits cubed still fits the precision, so the
    multiplications round nothing and the two have to give the same value.
    This is the check that caught a test for one that matched `1.5`, which
    made `1.5 ** 3` come back as one.
    """
    for text in ["1.5", "2.5", "3", "0.75", "1.25", "-1.5"]:
        var x = BigFloat.from_string(text, 53)
        var cubed = multiply(multiply(x, x, 53), x, 53)
        assert_equal(
            power(x, BigFloat.from_int(3, 53), 53).internal_representation(),
            cubed.internal_representation(),
            String("the cube of ") + text,
        )


def test_the_special_values_follow_ieee() raises:
    """The two that answer first, and the rest of the standard's table.

    A nought exponent gives one for every base and a base of one gives one
    for every exponent, both of them even for a NaN. After that a NaN gives a
    NaN, a negative base with a fractional exponent gives a NaN, and the
    infinities and noughts answer by sign and by the parity of a whole
    exponent.
    """
    var p = 53
    var nan = BigFloat.nan(p)
    var positive_zero = BigFloat.zero(p, False)
    var negative_zero = BigFloat.zero(p, True)
    var positive_infinity = BigFloat.infinity(p, False)
    var negative_infinity = BigFloat.infinity(p, True)
    var one = BigFloat.from_int(1, p)
    var two = BigFloat.from_int(2, p)
    var three = BigFloat.from_int(3, p)
    var half = BigFloat.from_string("0.5", p)

    # A nought exponent, whatever the base.
    var bases = [
        two.copy(),
        (-two).copy(),
        positive_zero.copy(),
        negative_zero.copy(),
        positive_infinity.copy(),
        negative_infinity.copy(),
        nan.copy(),
    ]
    for index in range(len(bases)):
        assert_equal(
            String(power(bases[index], positive_zero, p)),
            "1",
            "a nought exponent gives one",
        )
        assert_equal(
            String(power(bases[index], negative_zero, p)),
            "1",
            "a negative nought exponent gives one",
        )

    # A base of one, whatever the exponent.
    var exponents = [
        two.copy(),
        (-two).copy(),
        positive_infinity.copy(),
        negative_infinity.copy(),
        nan.copy(),
    ]
    for index in range(len(exponents)):
        assert_equal(
            String(power(one, exponents[index], p)),
            "1",
            "a base of one gives one",
        )

    assert_equal(_shape(power(nan, two, p)), "NaN", "a NaN base")
    assert_equal(_shape(power(two, nan, p)), "NaN", "a NaN exponent")
    assert_equal(_shape(power(-two, half, p)), "NaN", "no real answer")

    assert_equal(_shape(power(half, positive_infinity, p)), "+0", "inside one")
    assert_equal(
        _shape(power(half, negative_infinity, p)), "+Inf", "inside one"
    )
    assert_equal(_shape(power(two, positive_infinity, p)), "+Inf", "outside")
    assert_equal(_shape(power(two, negative_infinity, p)), "+0", "outside")
    assert_equal(
        String(power(-one, positive_infinity, p)),
        "1",
        "minus one is on neither side",
    )

    assert_equal(_shape(power(negative_infinity, three, p)), "-Inf", "odd")
    assert_equal(_shape(power(negative_infinity, two, p)), "+Inf", "even")
    assert_equal(_shape(power(negative_infinity, -three, p)), "-0", "odd")
    assert_equal(_shape(power(negative_infinity, -two, p)), "+0", "even")

    assert_equal(_shape(power(negative_zero, three, p)), "-0", "odd")
    assert_equal(_shape(power(negative_zero, two, p)), "+0", "even")
    assert_equal(_shape(power(negative_zero, -three, p)), "-Inf", "odd")
    assert_equal(_shape(power(positive_zero, -two, p)), "+Inf", "even")


def test_the_method_and_the_operator_agree() raises:
    """`a ** b`, `a.power(b)` and the free function are one thing."""
    var two = BigFloat.from_int(2, 53)
    var ten = BigFloat.from_int(10, 53)
    assert_equal(String(two**ten), "1024", "the operator")
    assert_equal(String(two.power(ten)), "1024", "the method")
    assert_equal(String(power(two, ten, 53)), "1024", "the free function")


def test_an_argument_past_the_exponent_range_is_refused() raises:
    """An answer whose exponent no `Int` holds is refused, not approximated.

    This type's exponent is as wide as an `Int`, so there is no infinity to
    overflow to that the value would have earned, which is the same stance
    `exp` takes.
    """
    var raised = False
    try:
        _ = power(
            BigFloat.from_int(2, 53),
            BigFloat.from_string("1e30", 53),
            53,
        )
    except:
        raised = True
    assert_true(raised, "2 ** 1e30 has no exponent an Int holds")


def main() raises:
    testing.TestSuite.discover_tests[__functions_in_module()]().run()
