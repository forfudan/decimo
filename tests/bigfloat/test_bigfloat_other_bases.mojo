        "1 7 -4 3 1 113 0 5974922884192683146508429008046761 -113 1",
        "1 7 -4 3 1 113 1 5974922884192683146508429008046762 -113 1",
        "1 7 -4 3 1 113 2 5974922884192683146508429008046761 -113 1",
        "1 7 -4 3 1 113 3 5974922884192683146508429008046762 -113 1",
        "1 7 -4 3 1 113 4 5974922884192683146508429008046762 -113 1",
        "1 7 -4 3 1 113 5 5974922884192683146508429008046762 -113 1",
        "1 7 -4 3 1 113 6 5974922884192683146508429008046762 -113 1",
    ]
    for row in cases:
        var field = row.split(" ")
        var x = _argument(
            String(field[1]),
            String(field[2]),
            String(field[3]),
            String(field[4]),
        )
        var destination = Int(String(field[5]))
        var mode = _modes()[Int(String(field[6]))]
        var got: BigFloat
        if field[0] == "0":
            got = expm1(x, destination, mode)
        else:
            got = log1p(x, destination, mode)
        assert_equal(
            got.internal_representation(),
            _expected(
                String(field[7]),
                String(field[8]),
                String(field[9]),
                destination,
            ),
            String("case ") + row,
        )


def test_log2_of_a_power_of_two_is_the_exponent() raises:
    """`log2(2^k)` is exactly `k`, over the whole exponent range.

    These are the arguments the loop that decides a rounding could never
    settle on, so they are the ones the implementation recognizes from the
    integer significand before any series runs. The range reaches four
    quintillion either way, which is as far as the exponent goes.

    At one and two bits of destination most of these answers do not fit, and
    then the mode decides the rounding of an exact integer, which is the
    second thing this checks.
    """
    var cases = [
        "0 1 0 1 0 1 0 0 0 0",
        "0 1 0 1 0 1 1 0 0 0",
