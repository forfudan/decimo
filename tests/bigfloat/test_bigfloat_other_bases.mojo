"""
Tests the other bases of `BigFloat`: `log2`, `log10`, `log`, `exp2`, `exp10`,
`expm1` and `log1p`, and the constant `ln10` they lean on.

The reference is CPython's `decimal` with the context precision set far above
what the answer needs, converted to an exact rational and then rounded to the
number of bits asked for by a short program working in `fractions.Fraction`.
So the tables hold the correctly rounded binary answer and not a
transcription of a decimal one.

Where the true answer is a rational number a decimal reference is no use:
`log10(1000)` comes out as `3.000...1` or `2.999...9` depending on the digit
count, and the two round to different floats in the directed modes because
the true value sits exactly on a boundary. Those answers are computed exactly
in Python integers instead, by a primitive-base decomposition -- a different
route than the implementation's square-root reduction and power search, so
that agreement means something.

Those same answers are what the implementation has to recognize before any
series runs, because Ziv's loop can never settle on a value a float holds
exactly. So the exact cases get tables of their own, over the whole exponent
range: `log2` of the powers of two from `2^-4e18` to `2^4e18`, `log10` of
`10^k` up to `k = 200`, `log(b^k, b)` for a dozen bases, and the halves that
a base which is a perfect square produces.
"""

from std import testing
from std.testing import assert_equal, assert_false, assert_true

from decimo.bigfloat.arithmetics import add, multiply, subtract
from decimo.bigfloat.bigfloat import BigFloat
from decimo.bigfloat.comparison import compare_absolute
from decimo.bigfloat.constants import ln10, ln2
from decimo.bigfloat.exponential import (
    exp,
    exp10,
    exp2,
    expm1,
    ln,
    log,
    log10,
    log1p,
    log2,
)
from decimo.bigint.bigint import BigInt
from decimo.rounding_mode import RoundingMode


def _modes() -> List[RoundingMode]:
    """All seven of them.

    Returns:
        The modes, in the order the rounding primitive documents them.
    """
    return [
        RoundingMode.ROUND_DOWN,
        RoundingMode.ROUND_UP,
        RoundingMode.ROUND_CEILING,
        RoundingMode.ROUND_FLOOR,
        RoundingMode.ROUND_HALF_UP,
        RoundingMode.ROUND_HALF_DOWN,
        RoundingMode.ROUND_HALF_EVEN,
    ]


def _argument(
    significand: String, exponent: String, precision: String, negative: String
) raises -> BigFloat:
    """Builds a test argument from its four fields.

    Args:
        significand: The significand, as text.
        exponent: The power of two, as text.
        precision: How many bits the significand holds.
        negative: "1" for a negative value.

    Returns:
        The value.

    Raises:
        Error: Propagated from the construction.
    """
    return BigFloat(
        significand=BigInt(significand),
        exponent=Int(exponent),
        precision=Int(precision),
        sign=negative == "1",
    )


def _expected(
    significand: String, exponent: String, negative: String, precision: Int
) -> String:
    """The internal representation a row expects.

    Args:
        significand: The expected significand.
        exponent: The expected power of two.
        negative: "1" for a negative answer.
        precision: The precision asked for.

    Returns:
        The text `internal_representation()` has to produce.
    """
    var text = String("-") if negative == "1" else String("")
    return text + significand + "p" + exponent + "@" + String(precision)


def _assert_close(
    left: BigFloat, right: BigFloat, units: Int, what: String
) raises:
    """Asserts that two values differ by at most `units` of the last place.

    Args:
        left: The first value.
        right: The second value.
        units: How many units in the last place to allow.
        what: What is being compared, for the message.

    Raises:
        Error: If they differ by more, or from the arithmetic.
    """
    var difference = subtract(left, right, left.precision + 4)
    if difference.is_zero():
        return
    var allowance = BigFloat(
        significand=BigInt(units),
        exponent=left.exponent,
        precision=BigInt(units).bit_length(),
        sign=False,
    )
    if compare_absolute(difference, allowance) > 0:
        raise Error(
            what
            + " differed by more than "
            + String(units)
            + " units in the last place: "
            + difference.internal_representation()
        )


def test_the_two_fixed_bases_are_what_the_reference_rounds_to() raises:
    """`log2` and `log10` against the reference, in all seven modes.

    The arguments run from a significand of one bit to one of three hundred,
    and from an exponent of nought to one of a quintillion either way, which
    is where the logarithm's own argument reduction is doing the most work.
    One of them is a float a hair above a power of two, where the answer is
    near a whole number without being one.

    The first field picks the function: nought for `log2`, one for `log10`.
    """
