        "9 0 4 0 27 0 5 113 6 6923062478046436838040661772293461 -113 0",
    ]
    for row in cases:
        var field = row.split(" ")
        var x = _argument(
            String(field[0]),
            String(field[1]),
            String(field[2]),
            String(field[3]),
        )
        var base = _argument(
            String(field[4]), String(field[5]), String(field[6]), "0"
        )
        var destination = Int(String(field[7]))
        var mode = _modes()[Int(String(field[8]))]
        assert_equal(
            log(x, base, destination, mode).internal_representation(),
            _expected(
                String(field[9]),
                String(field[10]),
                String(field[11]),
                destination,
            ),
            String("case ") + row,
        )


def test_the_two_exponentials_are_what_the_reference_rounds_to() raises:
    """`exp2` and `exp10` against the reference, in all seven modes.

    Both signs of argument, and a fractional part in every case, since the
    whole ones are exact and have their own table.

