    for row in cases:
        var field = row.split(" ")
        var x = _argument(
            String(field[1]),
            String(field[2]),
            String(field[3]),
            String(field[4]),
        )
        var destination = Int(String(field[5]))
        var mode = _modes()[Int(String(field[6]))]
        var got: BigFloat
        if field[0] == "0":
            got = log2(x, destination, mode)
        else:
            got = log2(x, destination, mode)
        assert_equal(
            got.internal_representation(),
            _expected(
                String(field[7]),
                String(field[8]),
                String(field[9]),
                destination,
            ),
            String("case ") + row,
        )


def test_log10_of_a_power_of_ten_is_the_exponent() raises:
    """`log10(10^k)` is exactly `k`, for every `k` that is an argument.

    Only `k` at nought or above: `10^-k` is not a binary float, a fifth not
    being a dyadic rational, so the negative powers of ten cannot be handed
    to this function at all. `log10` of the float nearest a thousandth is
    irrational and a hair from `-3`, and the series answers it.
    """
    var cases = [
        "1 1 0 1 0 1 0 0 0 0",
