        var x = _argument(
            String(field[1]),
            String(field[2]),
            String(field[3]),
            String(field[4]),
        )
        var destination = Int(String(field[5]))
        var mode = _modes()[Int(String(field[6]))]
        var got: BigFloat
        if field[0] == "0":
            got = log10(x, destination, mode)
        else:
            got = log10(x, destination, mode)
        assert_equal(
            got.internal_representation(),
            _expected(
                String(field[7]),
                String(field[8]),
                String(field[9]),
                destination,
            ),
            String("case ") + row,
        )


def test_a_whole_or_half_power_of_the_base_is_exact() raises:
    """`log(b^k, b)` is `k`, and `log(b^(k/2), b)` is `k/2`.

    The halves are the reason the base is reduced by its square roots before
    the whole-number search: `log(3, 9)` is exactly a half, which a float
    holds exactly, so without the reduction the loop would widen to its
    limit and refuse an argument whose answer it had in its hands.
    """
    var cases = [
        "1 0 1 0 3 0 2 1 0 0 0 0",
        "1 0 1 0 3 0 2 1 1 0 0 0",
