    for row in cases:
        var field = row.split(" ")
        var x = _argument(
            String(field[1]),
            String(field[2]),
            String(field[3]),
            String(field[4]),
        )
        var destination = Int(String(field[5]))
        var mode = _modes()[Int(String(field[6]))]
        var got: BigFloat
        if field[0] == "0":
            got = log2(x, destination, mode)
        else:
            got = log10(x, destination, mode)
        assert_equal(
            got.internal_representation(),
            _expected(
                String(field[7]),
                String(field[8]),
                String(field[9]),
                destination,
            ),
            String("case ") + row,
        )


def test_an_arbitrary_base_is_what_the_reference_rounds_to() raises:
    """`log` against the reference, in all seven modes.

    The bases include two below one, where the answer changes sign, and the
    powers of two, where the answer is a ratio of exponents. `log(9, 27)` is
    here because its answer is exactly two thirds: exact, and no binary
    float, so it goes through the series and has to come back correctly
    rounded like any other irrational answer.
    """
    var cases = [
        "7 0 3 0 3 0 2 1 0 1 0 0",
        "7 0 3 0 3 0 2 1 1 1 1 0",
        "7 0 3 0 3 0 2 1 2 1 1 0",
        "7 0 3 0 3 0 2 1 3 1 0 0",
        "7 0 3 0 3 0 2 1 4 1 1 0",
