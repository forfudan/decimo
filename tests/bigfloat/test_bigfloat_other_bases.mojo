def test_the_logarithm_of_ten_is_what_the_reference_rounds_to() raises:
    """The new constant, in all seven modes at six precisions.

    It is computed as `6 atanh(1/3) + 2 atanh(1/9)`, which is
    `3 ln 2 + ln(5/4)`; the reference is CPython's `Decimal(10).ln()`.
    """
    var cases = [
        "1 0 1 1 0",
        "1 1 1 2 0",
        "1 2 1 2 0",
        "1 3 1 1 0",
        "1 4 1 1 0",
        "1 5 1 1 0",
        "1 6 1 1 0",
        "2 0 2 0 0",
        "2 1 3 0 0",
        "2 2 3 0 0",
        "2 3 2 0 0",
        "2 4 2 0 0",
        "2 5 2 0 0",
        "2 6 2 0 0",
        "24 0 9657741 -22 0",
        "24 1 9657742 -22 0",
        "24 2 9657742 -22 0",
        "24 3 9657741 -22 0",
        "24 4 9657742 -22 0",
        "24 5 9657742 -22 0",
        "24 6 9657742 -22 0",
        "53 0 5184960683398421 -51 0",
        "53 1 5184960683398422 -51 0",
        "53 2 5184960683398422 -51 0",
        "53 3 5184960683398421 -51 0",
        "53 4 5184960683398422 -51 0",
        "53 5 5184960683398422 -51 0",
        "53 6 5184960683398422 -51 0",
        "113 0 5977852672431053671305377828242854 -111 0",
        "113 1 5977852672431053671305377828242855 -111 0",
        "113 2 5977852672431053671305377828242855 -111 0",
        "113 3 5977852672431053671305377828242854 -111 0",
        "113 4 5977852672431053671305377828242854 -111 0",
        "113 5 5977852672431053671305377828242854 -111 0",
        "113 6 5977852672431053671305377828242854 -111 0",
        (
            "300 0"
            " 1172612168250089822046955056753738238853265705320655181461313559146025335318905897960176410"
            " -298 0"
        ),
        (
            "300 1"
            " 1172612168250089822046955056753738238853265705320655181461313559146025335318905897960176411"
            " -298 0"
        ),
        (
            "300 2"
            " 1172612168250089822046955056753738238853265705320655181461313559146025335318905897960176411"
            " -298 0"
        ),
        (
            "300 3"
            " 1172612168250089822046955056753738238853265705320655181461313559146025335318905897960176410"
            " -298 0"
        ),
        (
            "300 4"
            " 1172612168250089822046955056753738238853265705320655181461313559146025335318905897960176411"
            " -298 0"
        ),
        (
            "300 5"
            " 1172612168250089822046955056753738238853265705320655181461313559146025335318905897960176411"
            " -298 0"
        ),
        (
            "300 6"
            " 1172612168250089822046955056753738238853265705320655181461313559146025335318905897960176411"
            " -298 0"
        ),
    ]
    for row in cases:
        var field = row.split(" ")
        var destination = Int(String(field[0]))
        var mode = _modes()[Int(String(field[1]))]
        assert_equal(
            ln10(destination, mode).internal_representation(),
            _expected(
                String(field[2]),
                String(field[3]),
                String(field[4]),
                destination,
            ),
            String("case ") + row,
        )


def test_the_constant_and_the_logarithm_agree() raises:
    """`ln(10)` and `ln10()` are two implementations of one number.

    The constant sums two inverse hyperbolic tangents in fixed-point
    integers; `ln` runs its own series on `(x-1)/(x+1)` in correctly rounded
    float operations. Different code, different error, same answer.
    """
    for precision in [1, 2, 53, 113, 300]:
        for mode in _modes():
            assert_equal(
                ln(
                    BigFloat.from_int(10), precision, mode
                ).internal_representation(),
                ln10(precision, mode).internal_representation(),
                String("ln(10) at ") + String(precision) + " bits",
            )


def test_the_fixed_bases_agree_with_the_arbitrary_one() raises:
    """`log2(x)` is `log(x, 2)` and `log10(x)` is `log(x, 10)`.

    The three take different routes -- two divide by a cached constant, the
    third takes the logarithm of its base -- so agreeing to the last bit in
    every mode is a real check on all three.
    """
    for text in ["3", "7", "0.1", "1.5", "1e10", "1e-10", "1234.5678"]:
        var x = BigFloat.from_string(text, 120)
        for mode in _modes():
            assert_equal(
                log2(x, 113, mode).internal_representation(),
                log(
                    x, BigFloat.from_int(2), 113, mode
                ).internal_representation(),
                String("log2 of ") + text,
            )
            assert_equal(
                log10(x, 113, mode).internal_representation(),
                log(
                    x, BigFloat.from_int(10), 113, mode
                ).internal_representation(),
                String("log10 of ") + text,
            )


def test_the_exponentials_agree_with_the_natural_one() raises:
    """`exp2(x)` is `exp(x ln 2)` and `exp10(x)` is `exp(x ln 10)`.

    Both sides are correctly rounded and the right-hand one rounds its
    product first, so they can differ in the last bits and not more. Three
    units in the last place is what two roundings and a multiply allow.
    """
    var precision = 120
    for text in ["0.5", "-0.5", "3.25", "-3.25", "0.001", "17.5"]:
        var x = BigFloat.from_string(text, precision)
        _assert_close(
            exp2(x, precision),
            exp(multiply(x, ln2(precision + 20), precision + 20), precision),
            3,
            String("exp2 of ") + text,
        )
        _assert_close(
            exp10(x, precision),
            exp(multiply(x, ln10(precision + 20), precision + 20), precision),
            3,
            String("exp10 of ") + text,
        )


def test_the_pairs_are_inverses() raises:
    """`exp2(log2(x))` is `x`, and the same for ten, and for the two near zero.

    Two roundings and two series stand between the two ends, so the
    comparison is at ten bits below the working precision. This check depends
    on no reference at all: it only says that each pair agrees about what the
    other one did.
    """
    for text in ["2", "7", "0.5", "1.25", "1e10", "1e-10", "1234.5678"]:
        var x = BigFloat.from_string(text, 160)
        for which in [0, 1, 2]:
            var back: BigFloat
            if which == 0:
                back = exp2(log2(x, 160), 160)
            elif which == 1:
                back = exp10(log10(x, 160), 160)
            else:
                back = expm1(log1p(x, 160), 160)
            assert_equal(
                BigFloat.from_rounded_parts(
                    back.significand, back.exponent, 150, back.sign
                ).internal_representation(),
                BigFloat.from_rounded_parts(
                    x.significand, x.exponent, 150, x.sign
                ).internal_representation(),
                String("the round trip of ") + text,
            )


def test_the_laws_hold_to_the_precision_asked_for() raises:
    """`log2(xy) = log2 x + log2 y` and `exp2(x+y) = exp2(x) exp2(y)`.

    Each side is correctly rounded and then combined, so the two sides can
    differ in their last bits but not more.
    """
    var precision = 120
    var pairs = [
        [String("3"), String("5")],
        [String("0.25"), String("1e8")],
        [String("1.5"), String("1.5")],
        [String("1e-5"), String("7")],
    ]
    for p in range(len(pairs)):
        var a = BigFloat.from_string(pairs[p][0], precision)
        var b = BigFloat.from_string(pairs[p][1], precision)

        var product = multiply(a, b, precision)
        _assert_close(
            log2(product, precision),
            add(log2(a, precision), log2(b, precision), precision),
            3,
            "the base-two logarithm of a product",
        )
        _assert_close(
            log10(product, precision),
            add(log10(a, precision), log10(b, precision), precision),
            3,
            "the base-ten logarithm of a product",
        )

        var total = add(a, b, precision)
        _assert_close(
            exp2(total, precision),
            multiply(exp2(a, precision), exp2(b, precision), precision),
            3,
            "the base-two exponential of a sum",
        )


def test_the_two_near_zero_keep_every_bit() raises:
    """`expm1` and `log1p` of an argument no width could see past.

    `exp(2^-100000) - 1` computed as it reads is nought, and
    `ln(1 + 2^-100000)` is nought too. Both of these answer `2^-100000`
    moved by one guard unit in the direction the quadratic term goes --
    away from zero for `expm1`, toward it for `log1p` -- and that direction
    is what the directed modes show.
    """
    var tiny = BigFloat.power_of_two(-100000)

    assert_equal(
        expm1(tiny, 53, RoundingMode.ROUND_DOWN).internal_representation(),
        "4503599627370496p-100052@53",
        "expm1 of a tiny argument, rounded down",
    )
    assert_equal(
        expm1(tiny, 53, RoundingMode.ROUND_UP).internal_representation(),
        "4503599627370497p-100052@53",
        "expm1 of a tiny argument, rounded up",
    )
    assert_equal(
        expm1(tiny, 53, RoundingMode.ROUND_HALF_EVEN).internal_representation(),
        "4503599627370496p-100052@53",
        "expm1 of a tiny argument, rounded half to even",
    )

    # `log1p(x)` is below `x`, so rounding down drops into the binade beneath.
    assert_equal(
        log1p(tiny, 53, RoundingMode.ROUND_DOWN).internal_representation(),
        "9007199254740991p-100053@53",
        "log1p of a tiny argument, rounded down",
    )
    assert_equal(
        log1p(tiny, 53, RoundingMode.ROUND_UP).internal_representation(),
        "4503599627370496p-100052@53",
        "log1p of a tiny argument, rounded up",
    )
    assert_equal(
        log1p(tiny, 53, RoundingMode.ROUND_HALF_EVEN).internal_representation(),
        "4503599627370496p-100052@53",
        "log1p of a tiny argument, rounded half to even",
    )

    # And from the other side of nought, where the two swap places.
    assert_equal(
        expm1(-tiny, 53, RoundingMode.ROUND_DOWN).internal_representation(),
        "-9007199254740991p-100053@53",
        "expm1 of a tiny negative argument, rounded down",
    )
    assert_equal(
        log1p(-tiny, 53, RoundingMode.ROUND_DOWN).internal_representation(),
        "-4503599627370496p-100052@53",
        "log1p of a tiny negative argument, rounded down",
    )


def test_expm1_saturates_just_inside_minus_one() raises:
    """`expm1` of a very negative argument, in all seven modes.

    `expm1(x)` falls short of minus one by `e^x`, which past the saturation
    bound is below half the distance from minus one to the float beside it.
    So the answer is one of those two, and which one is the mode's to say:
    reading a half-even kernel would answer minus one in every mode, which is
    wrong for `DOWN` and for `CEILING`.
    """
    for text in ["-100", "-1000", "-1e9", "-1e18"]:
        var x = BigFloat.from_string(text, 60)
        for which in range(7):
            var got = expm1(x, 53, _modes()[which]).internal_representation()
            if which == 0 or which == 2:
                # `DOWN` rounds toward zero and `CEILING` toward the greater
                # value; both take the neighbour rather than minus one.
                assert_equal(
                    got,
                    "-9007199254740991p-53@53",
                    String("expm1 of ") + text + " in mode " + String(which),
                )
            else:
                assert_equal(
                    got,
                    "-4503599627370496p-52@53",
                    String("expm1 of ") + text + " in mode " + String(which),
                )

    # An infinity is no shortfall at all: it is exactly minus one.
    for mode in _modes():
        assert_equal(
            expm1(-BigFloat.infinity(), 53, mode).internal_representation(),
            "-4503599627370496p-52@53",
            "expm1 of a negative infinity",
        )


def test_the_special_values_follow_ieee() raises:
    """A NaN, an infinity, a zero, a one, and a negative, for all seven."""
    var two = BigFloat.from_int(2)
    var half = BigFloat.from_string("0.5", 53)

    # The two fixed-base logarithms take what `ln` takes.
    for which in [0, 1]:
        var at_nan = log2(BigFloat.nan(), 53)
        var at_zero = log2(BigFloat.zero(), 53)
        var at_negative = log2(BigFloat.from_int(-2), 53)
        var at_infinity = log2(BigFloat.infinity(), 53)
        var at_one = log2(BigFloat.from_int(1), 53)
        if which == 1:
            at_nan = log10(BigFloat.nan(), 53)
            at_zero = log10(BigFloat.zero(), 53)
            at_negative = log10(BigFloat.from_int(-2), 53)
            at_infinity = log10(BigFloat.infinity(), 53)
            at_one = log10(BigFloat.from_int(1), 53)
        assert_true(at_nan.is_nan(), "a logarithm of a NaN")
        assert_true(at_zero.is_infinite(), "a logarithm of a zero")
        assert_true(at_zero.sign, "which runs to negative infinity")
        assert_true(at_negative.is_nan(), "a logarithm of a negative value")
        assert_true(at_infinity.is_infinite(), "a logarithm of an infinity")
        assert_true(at_one.is_zero(), "a logarithm of one is zero")
        assert_false(at_one.sign, "and it is a positive zero")
        assert_equal(at_one.precision, 53, "at the precision asked for")

    # A negative zero is no different: the sign of a zero says nothing about
    # the limit the logarithm approaches there.
    assert_true(
        log2(BigFloat.zero(53, True), 53).is_infinite(),
        "log2 of a negative zero",
    )
    assert_true(
        log10(BigFloat.zero(53, True), 53).is_infinite(),
        "log10 of a negative zero",
    )

    # An arbitrary base: what is not a base gives a NaN.
    assert_true(log(two, BigFloat.nan(), 53).is_nan(), "a NaN base")
    assert_true(log(BigFloat.nan(), two, 53).is_nan(), "a NaN argument")
    assert_true(
        log(two, BigFloat.from_int(1), 53).is_nan(), "a base of one is no base"
    )
    assert_true(log(two, BigFloat.zero(), 53).is_nan(), "a base of zero")
    assert_true(
        log(two, BigFloat.zero(53, True), 53).is_nan(), "a base of minus zero"
    )
    assert_true(log(two, BigFloat.from_int(-3), 53).is_nan(), "a negative base")
    assert_true(log(two, BigFloat.infinity(), 53).is_nan(), "an infinite base")
    assert_true(
        log(BigFloat.from_int(-3), two, 53).is_nan(), "a negative argument"
    )
    assert_equal(
        log(two, two, 53).internal_representation(),
        BigFloat.from_int(1, 53).internal_representation(),
        "log(b, b) is exactly one",
    )

    # A zero or an infinity takes its sign from which side of one the base is.
    assert_true(log(BigFloat.zero(), two, 53).sign, "log(0) in base two")
    assert_false(log(BigFloat.zero(), half, 53).sign, "log(0) in base a half")
    assert_false(log(BigFloat.infinity(), two, 53).sign, "log(inf) in base two")
    assert_true(
        log(BigFloat.infinity(), half, 53).sign, "log(inf) in base a half"
    )
    assert_true(
        log(BigFloat.zero(), two, 53).is_infinite(), "and they are infinities"
    )

    # The two exponentials.
    for which in [0, 1]:
        var at_nan = exp2(BigFloat.nan(), 53)
        var at_infinity = exp2(BigFloat.infinity(), 53)
        var at_negative_infinity = exp2(-BigFloat.infinity(), 53)
        var at_zero = exp2(BigFloat.zero(), 53)
        if which == 1:
            at_nan = exp10(BigFloat.nan(), 53)
            at_infinity = exp10(BigFloat.infinity(), 53)
            at_negative_infinity = exp10(-BigFloat.infinity(), 53)
            at_zero = exp10(BigFloat.zero(), 53)
        assert_true(at_nan.is_nan(), "an exponential of a NaN")
        assert_true(at_infinity.is_infinite(), "an exponential of an infinity")
        assert_true(
            at_negative_infinity.is_zero(),
            "an exponential of a negative infinity is a zero",
        )
        assert_equal(
            at_zero.internal_representation(),
            BigFloat.from_int(1, 53).internal_representation(),
            "an exponential of a zero is one",
        )

    # The two near zero keep the sign of a zero, as `sinh` does.
    for which in [0, 1]:
        var at_minus_zero = expm1(BigFloat.zero(53, True), 53)
        var at_plus_zero = expm1(BigFloat.zero(53, False), 53)
        if which == 1:
            at_minus_zero = log1p(BigFloat.zero(53, True), 53)
            at_plus_zero = log1p(BigFloat.zero(53, False), 53)
        assert_true(at_minus_zero.is_zero(), "nought in, nought out")
        assert_true(at_minus_zero.sign, "and the sign of the zero survives")
        assert_true(at_plus_zero.is_zero(), "both ways")
        assert_false(at_plus_zero.sign, "both ways")

    assert_true(expm1(BigFloat.nan(), 53).is_nan(), "expm1 of a NaN")
    assert_true(
        expm1(BigFloat.infinity(), 53).is_infinite(), "expm1 of an infinity"
    )
    assert_true(log1p(BigFloat.nan(), 53).is_nan(), "log1p of a NaN")
    assert_true(
        log1p(BigFloat.infinity(), 53).is_infinite(), "log1p of an infinity"
    )
    assert_true(
        log1p(-BigFloat.infinity(), 53).is_nan(),
        "log1p of a negative infinity has no value",
    )
    var at_minus_one = log1p(BigFloat.from_int(-1), 53)
    assert_true(at_minus_one.is_infinite(), "log1p of minus one")
    assert_true(at_minus_one.sign, "which runs to negative infinity")
    assert_true(
        log1p(BigFloat.from_string("-1.5", 53), 53).is_nan(),
        "log1p below minus one has no value",
    )


def test_a_whole_part_scales_out_of_exp2() raises:
    """`exp2(k + f)` is `exp2(f)` with `k` added to the exponent, exactly.

    Multiplying by a power of two is exact, so the two sides are the same
    number and both are correctly rounded: the significands have to match bit
    for bit and the exponents have to differ by exactly `k`.

    This is the check on the working width at a large argument, and it needs
    no reference. An error in an exponent is a relative error in the answer,
    so the product `x ln 2` has to carry bits in proportion to `x`'s own size;
    if it did not, a `k` of four quintillion would move the answer off the
    one `exp2(f)` gives.
    """
    for text in ["0.5", "0.25", "-0.25", "0.75"]:
        var fraction = BigFloat.from_string(text, 60)
        var small = exp2(fraction, 53)
        for whole in [
            100,
            1000,
            1_000_000,
            1_000_000_000_000,
            4_000_000_000_000_000_000,
            -4_000_000_000_000_000_000,
        ]:
            var shifted = add(BigFloat.from_int(whole, 70), fraction, 70)
            var got = exp2(shifted, 53)
            assert_equal(
                String(got.significand),
                String(small.significand),
                String("exp2 of ") + String(whole) + " + " + text,
            )
            assert_equal(
                got.exponent,
                small.exponent + whole,
                String("the exponent of exp2 of ")
                + String(whole)
                + " + "
                + text,
            )


def test_the_two_exponentials_agree_at_a_large_argument() raises:
    """`exp10(x)` is `exp2(x log2 10)`, to the last few bits.

    The two take different routes -- one multiplies by the logarithm of ten
    and one by the logarithm of two -- and both have to carry bits in
    proportion to the argument's size. The product is formed eighty bits
    wider than the answer so that its own rounding is not what is being
    measured.
    """
    var precision = 120
    var wide = precision + 80
    var scale = log2(BigFloat.from_int(10), wide)
    for text in ["17.5", "1000.25", "1e6", "1234567.5", "1e12"]:
        var x = BigFloat.from_string(text, 60)
        _assert_close(
            exp10(x, precision),
            exp2(multiply(x, scale, wide), precision),
            3,
            String("exp10 against exp2 at ") + text,
        )


def test_the_range_ends_where_the_exponent_does() raises:
    """`exp2(x)` has an answer exactly while the whole part of `x` has an `Int`.

    There is no overflow to an infinity here, as there is none for `exp`: the
    exponent is as wide as an `Int`, so an argument that asks for more is
    refused rather than answered with an infinity it did not earn. For
    `exp10` the end comes earlier by a factor of `log2(10)`.
    """
    var accepted = exp2(BigFloat.from_string("9e18", 60), 53)
    assert_true(accepted.is_finite(), "9e18 has a base-two answer")
    assert_true(
        accepted.exponent > 8_000_000_000_000_000_000,
        "and its exponent is about 9e18",
    )
    assert_true(
        exp10(BigFloat.from_string("2.7e18", 60), 53).is_finite(),
        "and 2.7e18 has a base-ten one",
    )

    for text in ["1e19", "1e30", "-1e30"]:
        var raised = False
        try:
            _ = exp2(BigFloat.from_string(text, 60), 53)
        except:
            raised = True
        assert_true(raised, String("exp2 of ") + text + " invented an exponent")

    for text in ["3e18", "1e19", "-1e19"]:
        var raised = False
        try:
            _ = exp10(BigFloat.from_string(text, 60), 53)
        except:
            raised = True
        assert_true(
            raised, String("exp10 of ") + text + " invented an exponent"
        )


def test_a_precision_must_fit_the_guard_bits() raises:
    """Every one of the seven refuses a precision that is not a precision."""
    var two = BigFloat.from_int(2)
    var three = BigFloat.from_int(3)
    for precision in [0, -1, Int.MAX, Int.MAX // 4 + 1]:
        for which in range(8):
            var raised = False
            try:
                if which == 0:
                    _ = log2(two, precision)
                elif which == 1:
                    _ = log10(two, precision)
                elif which == 2:
                    _ = log(two, three, precision)
                elif which == 3:
                    _ = exp2(two, precision)
                elif which == 4:
                    _ = exp10(two, precision)
                elif which == 5:
                    _ = expm1(two, precision)
                elif which == 6:
                    _ = log1p(two, precision)
                else:
                    _ = ln10(precision)
            except:
                raised = True
            assert_true(
                raised,
                String("a precision of ") + String(precision) + " was taken",
            )


def main() raises:
    testing.TestSuite.discover_tests[__functions_in_module()]().run()
