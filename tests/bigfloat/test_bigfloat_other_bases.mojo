        "0 7 -3 3 1 113 3 5662239874525754974216524420526410 -113 0",
        "0 7 -3 3 1 113 4 5662239874525754974216524420526410 -113 0",
        "0 7 -3 3 1 113 5 5662239874525754974216524420526410 -113 0",
        "0 7 -3 3 1 113 6 5662239874525754974216524420526410 -113 0",
        "1 7 -3 3 1 113 0 5539231314408393269209242634797709 -115 0",
        "1 7 -3 3 1 113 1 5539231314408393269209242634797710 -115 0",
        "1 7 -3 3 1 113 2 5539231314408393269209242634797710 -115 0",
        "1 7 -3 3 1 113 3 5539231314408393269209242634797709 -115 0",
        "1 7 -3 3 1 113 4 5539231314408393269209242634797709 -115 0",
        "1 7 -3 3 1 113 5 5539231314408393269209242634797709 -115 0",
        "1 7 -3 3 1 113 6 5539231314408393269209242634797709 -115 0",
    ]
    for row in cases:
        var field = row.split(" ")
        var x = _argument(
            String(field[1]),
            String(field[2]),
            String(field[3]),
            String(field[4]),
        )
        var destination = Int(String(field[5]))
        var mode = _modes()[Int(String(field[6]))]
        var got: BigFloat
        if field[0] == "0":
            got = exp2(x, destination, mode)
        else:
            got = exp10(x, destination, mode)
        assert_equal(
            got.internal_representation(),
            _expected(
                String(field[7]),
                String(field[8]),
                String(field[9]),
                destination,
            ),
            String("case ") + row,
        )


def test_the_two_near_zero_are_what_the_reference_rounds_to() raises:
    """`expm1` and `log1p` against the reference, in all seven modes.

    The small arguments are the point of both functions, so the table runs
    down to `2^-100` and `2^-70`, where `exp(x) - 1` and `ln(1 + x)` computed
    as they read would answer nought and this has to answer `x` less a
    little. The reference for those is a rational one: a dyadic `x` makes
    every term of the series an exact fraction.

    The first field picks the function: nought for `expm1`, one for `log1p`.
    """
    var cases = [
        "0 3 -1 2 0 1 0 1 1 0",
        "0 3 -1 2 0 1 1 1 2 0",
        "0 3 -1 2 0 1 2 1 2 0",
        "0 3 -1 2 0 1 3 1 1 0",
