        False,
        True,
        True,
        True,
        True,
        True,
        True,
        True,
        True,
        True,
        True,
        True,
        True,
        True,
        True,
        False,
        False,
        False,
        False,
        False,
        False,
        False,
        False,
        False,
        False,
        False,
        False,
        False,
        False,
    ]
    for i in range(len(kinds)):
        var x = BigFloat(
            significand=BigInt(significands[i]),
            exponent=exponents[i],
            precision=precisions[i],
            sign=False,
        )
        var got = sin(x, destinations[i], modes[picks[i]]) if kinds[
            i
        ] == 0 else (
            cos(x, destinations[i], modes[picks[i]]) if kinds[i]
            == 1 else tan(x, destinations[i], modes[picks[i]])
        )
        var want = String("-") if negatives[i] else String("")
        want += (
            values[i]
            + "p"
            + String(value_exponents[i])
            + "@"
            + String(destinations[i])
        )
        assert_equal(
            got.internal_representation(),
            want,
            String("kind ")
            + String(kinds[i])
            + " of "
            + significands[i]
            + "p"
            + String(exponents[i])
            + " at "
            + String(destinations[i])
            + " bits, "
            + String(modes[picks[i]]),
        )


def test_the_identity_holds_everywhere() raises:
    """`sin^2 + cos^2 = 1`, which no reference is needed to check.

    The two are computed by different paths through the same reduction -- in
    half the quadrants they even swap series -- so this says the quadrant
    bookkeeping is right as well as the series.
    """
    var precision = 120
    for text in [
        "0.5",
        "1",
        "2",
        "3",
        "-1.5",
        "100",
        "1e10",
        "0.0001",
        "1e30",
    ]:
        var x = BigFloat.from_string(text, precision)
        var s = sin(x, precision)
        var c = cos(x, precision)
        var total = add(
            multiply(s, s, precision), multiply(c, c, precision), precision
        )
        var error = subtract(total, BigFloat.from_int(1, precision), precision)
        if error.is_zero():
            continue
        # Four units in the last place of one, which two squares and a sum
        # allow.
        var allowance = BigFloat(
            significand=BigInt.one(),
            exponent=-(precision - 3),
            precision=1,
            sign=False,
        )
        assert_true(
            compare_absolute(error, allowance) <= 0,
            String("sin^2 + cos^2 at ") + text,
        )


def test_the_tangent_is_the_quotient() raises:
    """`tan = sin / cos`, computed two ways.

    The tangent's kernel divides the two series rather than the two rounded
    answers, so this is not the same arithmetic and the two can differ in
    their last bits, not more.
    """
    var precision = 100
    for text in ["0.5", "1", "2", "-1.5", "10", "1.5707963"]:
        var x = BigFloat.from_string(text, precision)
        var quotient = BigFloat.from_rounded_parts(
            tan(x, precision).significand,
            tan(x, precision).exponent,
            precision - 8,
            tan(x, precision).sign,
        )
        var from_parts = sin(x, precision) / cos(x, precision)
        assert_equal(
            quotient.internal_representation(),
            BigFloat.from_rounded_parts(
                from_parts.significand,
                from_parts.exponent,
                precision - 8,
                from_parts.sign,
            ).internal_representation(),
            String("the tangent of ") + text,
        )


def test_an_argument_below_the_last_place_is_answered_not_iterated() raises:
    """A tiny argument has an answer the series cannot reach.

    `sin(x)` is `x` and `cos(x)` is `1 - x^2/2` there, to every bit that
    matters. The loop that decides a rounding widens geometrically, so an
    argument like `2^-100000` would run out of widenings before it could tell
    which side of the answer it was on; these come back without it.
    """
    var tiny = BigFloat.from_string("1e-30000", 53)
    assert_equal(
        sin(tiny, 53).internal_representation(),
        tiny.internal_representation(),
        "the sine of a tiny argument is the argument",
    )
    assert_equal(
        tan(tiny, 53).internal_representation(),
        tiny.internal_representation(),
        "and so is the tangent",
    )

    # The cosine is one, and the directed modes have to say which side.
    assert_equal(
        cos(tiny, 53, RoundingMode.ROUND_HALF_EVEN).internal_representation(),
        BigFloat.from_int(1, 53).internal_representation(),
        "the cosine rounds to one",
    )
    var below = cos(tiny, 53, RoundingMode.ROUND_DOWN)
    assert_true(
        below < BigFloat.from_int(1, 53),
        "but toward zero it is the value below one",
    )
    assert_equal(
        below.internal_representation(),
        BigFloat(
            significand=(BigInt.one() << 53) - BigInt.one(),
            exponent=-53,
            precision=53,
            sign=False,
        ).internal_representation(),
        "which is one unit below, in the binade below",
    )


def test_the_special_values_follow_ieee() raises:
    """An infinity has no sine, and a zero keeps its sign."""
    for value in [BigFloat.nan(), BigFloat.infinity(), -BigFloat.infinity()]:
        assert_true(sin(value, 53).is_nan(), "the sine does not settle")
        assert_true(cos(value, 53).is_nan(), "nor does the cosine")
        assert_true(tan(value, 53).is_nan(), "nor the tangent")

    assert_true(sin(BigFloat.zero(), 53).is_zero(), "the sine of zero")
    assert_false(sin(BigFloat.zero(), 53).sign, "keeps the sign it had")
    assert_true(
        sin(BigFloat.zero(53, True), 53).sign, "including a negative one"
    )
    assert_equal(
        cos(BigFloat.zero(), 53).internal_representation(),
        BigFloat.from_int(1, 53).internal_representation(),
        "the cosine of zero is one",
    )
    assert_true(tan(BigFloat.zero(53, True), 53).sign, "the tangent of -0")


def test_pi_lands_where_it_should() raises:
    """The sine of pi is not zero, and the reduction has to show that.

    No binary float is pi, so `sin(pi_at_p_bits)` is the sine of a value a
    little away from pi, which is about that distance. Getting a zero here
    would mean the reduction had thrown away the argument's low bits.
    """
    for precision in [53, 120, 300]:
        var value = sin(pi(precision), precision)
        assert_true(
            not value.is_zero(), "the sine of a rounded pi is not nought"
        )
        # It is about the distance from the rounded pi to pi, which is at
        # most a unit in its last place.
        var unit = BigFloat(
            significand=BigInt.one(),
            exponent=-(precision - 2),
            precision=1,
            sign=False,
        )
        assert_true(
            compare_absolute(value, unit) < 0,
            "and it is no larger than a unit in pi's last place",
        )


def test_a_precision_must_fit_the_guard_bits() raises:
    for precision in [0, -1, Int.MAX, Int.MAX // 4 + 1]:
        for which in [0, 1, 2]:
            var raised = False
            try:
                if which == 0:
                    _ = sin(BigFloat.from_int(1), precision)
                elif which == 1:
                    _ = cos(BigFloat.from_int(1), precision)
                else:
                    _ = tan(BigFloat.from_int(1), precision)
            except:
                raised = True
            assert_true(
                raised,
                String("a precision of ") + String(precision) + " was taken",
            )


def main() raises:
    testing.TestSuite.discover_tests[__functions_in_module()]().run()
