        "1 12 1 0 6 113 0 5192296858534827628530496329220096 -110 0",
        "1 12 1 0 6 113 1 5192296858534827628530496329220096 -110 0",
        "1 12 1 0 6 113 2 5192296858534827628530496329220096 -110 0",
        "1 12 1 0 6 113 3 5192296858534827628530496329220096 -110 0",
        "1 12 1 0 6 113 4 5192296858534827628530496329220096 -110 0",
