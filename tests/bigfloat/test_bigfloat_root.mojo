"""
Tests `BigFloat`'s `root` and `cbrt`.

A root is algebraic, so the expectations are exact wherever the answer is: an
integer `n`-th root of the numerator and the denominator says whether the
value is a perfect power, and when it is, the answer is a rational and is
rounded from that. Only the irrational roots go through a high-precision
`decimal`, and each of those is computed twice, sixty digits apart, and kept
only when both round the same way.

That exactness is the point of the implementation as well. `root(8, 3)` is
two in every mode, which a function that evaluated and then rounded could not
promise, and which is why this one takes an integer root of a scaled
significand and reads the remainder as the sticky bit instead.
"""

from std import testing
from std.testing import assert_equal, assert_true

from decimo.bigfloat.bigfloat import BigFloat
from decimo.bigfloat.exponential import cbrt, root, sqrt
from decimo.bigint.bigint import BigInt
from decimo.rounding_mode import RoundingMode


def _modes() -> List[RoundingMode]:
    """The seven modes, in the order the table indexes them."""
    return [
        RoundingMode.ROUND_DOWN,
        RoundingMode.ROUND_UP,
        RoundingMode.ROUND_CEILING,
        RoundingMode.ROUND_FLOOR,
        RoundingMode.ROUND_HALF_UP,
        RoundingMode.ROUND_HALF_DOWN,
        RoundingMode.ROUND_HALF_EVEN,
    ]


def _shape(x: BigFloat) -> String:
    """A name for a special value, so a failure says which one it is."""
    if x.is_nan():
        return "NaN"
    if x.is_infinite():
        return "-Inf" if x.sign else "+Inf"
    if x.is_zero():
        return "-0" if x.sign else "+0"
    return "finite"


def test_the_values_are_what_the_reference_rounds_to() raises:
    """Twenty-three values at degrees from one to ten, four precisions, seven
    modes.

    The values cover perfect powers and values that are not, both signs at
    the odd degrees, values above and below one, and one past what a double
    holds.
    """
    var modes = _modes()
    # significand exponent precision negative degree destination mode
    # expected_significand expected_exponent expected_negative
    var cases = [
