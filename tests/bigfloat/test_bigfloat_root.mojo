    for row in cases:
        var field = row.split(" ")
        var x = BigFloat(
            significand=BigInt(String(field[0])),
            exponent=Int(String(field[1])),
            precision=Int(String(field[2])),
            sign=field[3] == "1",
        )
        var destination = Int(String(field[5]))
        var got = root(
            x,
            Int(String(field[4])),
            destination,
            modes[Int(String(field[6]))],
        )
        var want = String("-") if field[9] == "1" else String("")
        want += (
            String(field[7])
            + "p"
            + String(field[8])
            + "@"
            + String(destination)
        )
        assert_equal(got.internal_representation(), want, String("case ") + row)


def test_an_exact_root_is_exact_in_every_mode() raises:
    """A perfect power gives its root exactly, whatever the mode.

    The directed modes are the test. A value that evaluated the root and then
    rounded would have to choose a side, and both sides are wrong: the answer
    sits exactly on the boundary. The integer root says it is exact by
    leaving no remainder.
    """
    var modes = _modes()
    var cases = [
        [String("8"), String("3"), String("2")],
        [String("27"), String("3"), String("3")],
        [String("-8"), String("3"), String("-2")],
        [String("16"), String("4"), String("2")],
        [String("32"), String("5"), String("2")],
        [String("1000"), String("3"), String("10")],
        [String("0.125"), String("3"), String("0.5")],
        [String("256"), String("8"), String("2")],
        [String("390625"), String("8"), String("5")],
    ]
    for trio in cases:
        for index in range(7):
            assert_equal(
                String(
                    root(
                        BigFloat.from_string(trio[0], 53),
                        Int(trio[1]),
                        53,
                        modes[index],
                    )
                ),
                trio[2],
                trio[0] + " root " + trio[1] + " in mode " + String(index),
            )


def test_a_degree_of_two_agrees_with_the_square_root() raises:
    """`root(x, 2)` and `sqrt(x)` are the same number.

    They are also the same code -- the degree of two is handed straight to
    `sqrt` -- so this says the handing off is right rather than that two
    methods agree.
    """
    for text in ["2", "3", "4", "9", "10", "0.5", "1.5", "1e10", "6.25"]:
        var x = BigFloat.from_string(text, 113)
        assert_equal(
            root(x, 2, 113).internal_representation(),
            sqrt(x, 113).internal_representation(),
            String("the square root of ") + text,
        )


def test_a_degree_of_one_gives_the_value_back() raises:
    """`root(x, 1)` is `x`, rounded to the precision asked for."""
    for text in ["2", "-3", "0.1", "1e10"]:
        var x = BigFloat.from_string(text, 113)
        assert_equal(
            root(x, 1, 113).internal_representation(),
            x.internal_representation(),
            String("the first root of ") + text,
        )


def test_the_special_values_behave() raises:
    """A nought, an infinity, a NaN, and a negative at each parity.

    A negative value has a real root only at an odd degree. A nought keeps
    its sign at an odd degree, because an odd power of a negative nought is
    one, and loses it at an even degree, where the root is a positive nought.
    """
    var p = 53
    assert_equal(_shape(root(BigFloat.zero(p, False), 3, p)), "+0", "+0 cubed")
    assert_equal(_shape(root(BigFloat.zero(p, True), 3, p)), "-0", "-0 cubed")
    assert_equal(
        _shape(root(BigFloat.zero(p, True), 4, p)), "+0", "-0 at an even degree"
    )
    assert_equal(
        _shape(root(BigFloat.infinity(p, False), 3, p)), "+Inf", "+Inf"
    )
    assert_equal(
        _shape(root(BigFloat.infinity(p, True), 3, p)), "-Inf", "-Inf, odd"
    )
    assert_equal(
        _shape(root(BigFloat.infinity(p, True), 4, p)), "NaN", "-Inf, even"
    )
    assert_equal(_shape(root(BigFloat.nan(p), 3, p)), "NaN", "a NaN")
    assert_equal(
        _shape(root(BigFloat.from_int(-8, p), 4, p)),
        "NaN",
        "a negative value at an even degree",
    )


def test_a_degree_that_is_not_a_degree_is_refused() raises:
    """Nought and a negative degree raise rather than answer."""
    for degree in [0, -1, -3]:
        var raised = False
        try:
            _ = root(BigFloat.from_int(8, 53), degree, 53)
        except:
            raised = True
        assert_true(
            raised, String("a degree of ") + String(degree) + " was refused"
        )


def test_the_methods_agree_with_the_functions() raises:
    """`x.cbrt()` and `x.root(n)` are the free functions at this precision."""
    var eight = BigFloat.from_int(8, 53)
    assert_equal(String(eight.cbrt()), "2", "the cube root method")
    assert_equal(String(eight.root(3)), "2", "the root method")
    assert_equal(String(cbrt(eight, 53)), "2", "the cube root function")


def test_a_large_degree_goes_through_the_logarithm() raises:
    """A root of a high degree is taken a different way, and still rounds.

    The integer root needs the value lengthened to about the degree times the
    precision, so a high degree asked for a number nothing could hold and the
    program stopped. Those roots now go through the logarithm instead, where
    the cost does not grow with the degree.

    The expectations come from a high-precision decimal, computed twice and
    kept only where both agree.
