            + "@"
            + String(destination),
            String("case ") + row,
        )


def test_a_power_of_two_keeps_its_exact_root_at_any_degree() raises:
    """`2^1000000` to the thousandth is `2^1000`, and nothing has to be built.

    A power of two is the one base whose root can still be exact at a high
    degree, so it is answered before the logarithm is reached. The test is
    that it comes out exact in every mode, which a computed answer could not
    promise.
    """
    var modes = _modes()
    var big = BigFloat(
        significand=BigInt("1"), exponent=1000000, precision=1, sign=False
    )
    for index in range(7):
        var got = root(big, 1000, 53, modes[index])
        assert_equal(
            got.significand == BigInt("1") << 52 and got.exponent == 1000 - 52,
            True,
            String("two to the millionth, rooted, in mode ") + String(index),
        )


def test_a_degree_too_large_for_the_old_method_still_answers() raises:
    """Degrees that used to stop the program now give an answer.

    Each of these asked the integer root for a value of some gigabits. They
    are ordinary questions with ordinary answers, every one of them just
    above one -- and once the degree is large enough, so little above it that
    fifty-three bits cannot tell the difference, which is the right answer
    rather than a failure.
    """
    var two = BigFloat.from_int(2, 53)
    var one = BigFloat.from_int(1, 53)
    for degree in [100000000, 1000000000]:
        var got = root(two, degree, 53)
        assert_equal(got.sign, False, "a root of two is positive")
        assert_equal(
            compare_absolute(got, one) > 0,
            True,
            String("a root of two is above one at degree ") + String(degree),
        )
        assert_equal(
            compare_absolute(got, BigFloat.from_string("1.001", 53)) < 0,
            True,
            String("and only just, at degree ") + String(degree),
        )
    # A thousand million million million brings the root within a fifth of
    # the last place of one, so one is what it rounds to.
    assert_equal(
        String(root(two, 1000000000000000000, 53)),
        "1",
        "a degree of ten to the eighteenth rounds to one",
    )


def main() raises:
    testing.TestSuite.discover_tests[__functions_in_module()]().run()
