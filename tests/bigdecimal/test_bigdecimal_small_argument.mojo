"""
Tests the decimal transcendentals at an argument too small for the loop.

Every one of them comes to a value the destination holds exactly as its
argument goes to nought -- the argument itself, or one, or one over the
argument -- and a kernel that lands on such a value says nothing about which
side of it the truth lies. The loop that decides a rounding cannot settle
there at any width, so each function has to answer the case directly.

The reference is a Python program using nothing but exact rationals. Each
function's series converges in two or three terms at these magnitudes, so
the value is a `Fraction` with no error at all, and the rounding to the
digits asked for is done on that fraction by hand in all seven modes. The
expected strings below came from that program and not from this library.

The arguments cover what can go wrong: both signs, a power of ten and a
value that is not one, a destination of a single digit where the answer sits
on a tie, an argument whose reciprocal does not terminate, and one just
above the size where the branch stops firing, so that the loop's own path is
measured against the same reference.
"""

from std import testing
from std.testing import assert_equal, assert_true

from decimo.bigdecimal.bigdecimal import BigDecimal
from decimo.bigdecimal.exponential import (
    exp_rounded,
    expm1_rounded,
    ln_rounded,
    log1p_rounded,
)
from decimo.bigdecimal.hyperbolic import (
    arcsinh_rounded,
    arctanh_rounded,
    cosh_rounded,
    sinh_rounded,
    tanh_rounded,
)
from decimo.bigdecimal.trigonometric import (
    arcsin_rounded,
    arctan_rounded,
    cos_rounded,
    cot_rounded,
    csc_rounded,
    sec_rounded,
    sin_rounded,
    tan_rounded,
)
from decimo.rounding_mode import RoundingMode


comptime _FUNCTIONS = 17
"""How many functions the table covers, which is every one that has a limit
the destination can hold."""


def _modes() -> List[RoundingMode]:
    """All seven, in the order the table's third field counts them.

    Returns:
        The modes.
    """
    return [
        RoundingMode.ROUND_DOWN,
        RoundingMode.ROUND_UP,
        RoundingMode.ROUND_CEILING,
        RoundingMode.ROUND_FLOOR,
        RoundingMode.ROUND_HALF_UP,
        RoundingMode.ROUND_HALF_DOWN,
        RoundingMode.ROUND_HALF_EVEN,
    ]


def _arguments() raises -> List[BigDecimal]:
    """The arguments the table's second field counts.

    Returns:
        The six of them.
    """
    return [
        BigDecimal.from_string("1E-500"),
        BigDecimal.from_string("-1E-500"),
        BigDecimal.from_string("4E-500"),
        BigDecimal.from_string("1.5E-500"),
        BigDecimal.from_string("-7.3E-999"),
        BigDecimal.from_string("1E-11"),
    ]


def _precisions() -> List[Int]:
    """The digits wanted of each argument, one per argument.

    Returns:
        The six of them. Two are a single digit, where the answer lands on a
        tie and on a midpoint of the destination.
    """
    return [20, 20, 1, 1, 20, 20]


def _names() -> List[String]:
    """The function names the table's first field counts.

    Returns:
        The seventeen of them, for the message a failure carries.
    """
    return [
        String("sin"),
        String("cos"),
        String("tan"),
        String("cot"),
        String("csc"),
        String("sec"),
        String("arcsin"),
        String("arctan"),
        String("sinh"),
        String("cosh"),
        String("tanh"),
        String("arcsinh"),
        String("arctanh"),
        String("exp"),
        String("expm1"),
        String("log1p"),
        String("ln"),
    ]


def _applied(
    which: Int, x: BigDecimal, precision: Int, mode: RoundingMode
) raises -> BigDecimal:
    """One of the seventeen, by the index the table counts it with.

    Args:
        which: Which function.
        x: The argument. `ln` is given one plus it, since it is the one
            function whose limit is reached at one rather than at nought.
        precision: The digits wanted.
        mode: How to round.

    Returns:
        What that function returns.

    Raises:
        Error: Propagated from the function.
    """
    if which == 0:
        return sin_rounded(x, precision, mode)
    elif which == 1:
        return cos_rounded(x, precision, mode)
    elif which == 2:
        return tan_rounded(x, precision, mode)
    elif which == 3:
        return cot_rounded(x, precision, mode)
    elif which == 4:
        return csc_rounded(x, precision, mode)
    elif which == 5:
        return sec_rounded(x, precision, mode)
    elif which == 6:
        return arcsin_rounded(x, precision, mode)
    elif which == 7:
        return arctan_rounded(x, precision, mode)
    elif which == 8:
        return sinh_rounded(x, precision, mode)
    elif which == 9:
        return cosh_rounded(x, precision, mode)
    elif which == 10:
        return tanh_rounded(x, precision, mode)
    elif which == 11:
        return arcsinh_rounded(x, precision, mode)
    elif which == 12:
        return arctanh_rounded(x, precision, mode)
    elif which == 13:
        return exp_rounded(x, precision, mode)
    elif which == 14:
        return expm1_rounded(x, precision, mode)
    elif which == 15:
        return log1p_rounded(x, precision, mode)
    else:
        return ln_rounded(BigDecimal.one().add(x), precision, mode)


