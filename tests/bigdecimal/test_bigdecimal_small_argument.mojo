def test_the_values_are_what_the_reference_rounds_to() raises:
    """The whole table, row by row."""
    var modes = _modes()
    var arguments = _arguments()
    var precisions = _precisions()
    var names = _names()

    for row in _rows():
        var field = row.split(" ")
        var which = Int(String(field[0]))
        var index = Int(String(field[1]))
        var mode = modes[Int(String(field[2]))]
        var precision = precisions[index]
        var got = _applied(which, arguments[index], precision, mode)
        assert_equal(
            String(got),
            String(field[3]),
            String("the ")
            + names[which]
            + " of "
            + String(arguments[index])
            + " at "
            + String(precision)
            + " digits, "
            + String(mode),
        )


def test_none_of_them_raises_where_all_of_them_used_to() raises:
    """Every function, every mode, at an argument the loop cannot reach.

    This is the regression. Before the direct answers, each of the seventeen
    raised `the rounding of this value could not be decided` in the four
    directed modes -- not for a value it could not represent, but for a
    value it held exactly.
    """
    var tiny = BigDecimal.from_string("1E-700")
    for which in range(_FUNCTIONS):
        for mode in _modes():
            var got = _applied(which, tiny, 28, mode)
            assert_true(
                not got.is_zero(),
                String("function ") + String(which) + " came to nought",
            )


def test_the_branch_leaves_the_ordinary_arguments_alone() raises:
    """A moderate argument is still the loop's to answer.

    The direct answers are for arguments whose correction cannot be
    computed. One that can be must not take them, or the answer would be
    the argument where it should be the argument plus a visible term: the
    sine of a thousandth differs from a thousandth in the seventh digit.
    """
    var x = BigDecimal.from_string("0.001")
    assert_equal(
        String(sin_rounded(x, 20, RoundingMode.ROUND_HALF_EVEN)),
        "0.00099999983333334166667",
    )
    assert_equal(
        String(tan_rounded(x, 20, RoundingMode.ROUND_HALF_EVEN)),
        "0.0010000003333334666667",
    )
    assert_equal(
        String(cos_rounded(x, 20, RoundingMode.ROUND_HALF_EVEN)),
        "0.99999950000004166667",
    )
    assert_equal(
        String(cot_rounded(x, 20, RoundingMode.ROUND_HALF_EVEN)),
        "999.99966666664444444",
    )


def test_a_tie_at_one_digit_goes_the_way_the_truth_does() raises:
    """Where the argument is a tie, the correction decides it.

    `1.5E-500` is halfway between the two values a single digit can hold,
    and `sin` of it is below the tie while `tan` of it is above. So
    half-even has to answer one where the sine is asked and two where the
    tangent is, and reading a kernel that returns the tie itself could not.
    """
    var x = BigDecimal.from_string("1.5E-500")
    assert_equal(
        String(sin_rounded(x, 1, RoundingMode.ROUND_HALF_EVEN)), "1E-500"
    )
    assert_equal(
        String(tan_rounded(x, 1, RoundingMode.ROUND_HALF_EVEN)), "2E-500"
    )
    assert_equal(
        String(arcsin_rounded(x, 1, RoundingMode.ROUND_HALF_EVEN)), "2E-500"
    )
    assert_equal(
        String(arctan_rounded(x, 1, RoundingMode.ROUND_HALF_EVEN)), "1E-500"
    )


def main() raises:
    testing.TestSuite.discover_tests[__functions_in_module()]().run()


def test_the_trailing_zeros_of_an_argument_are_not_its_last_place() raises:
    """The same value, written with a thousand digits, gets the same answer.

    A `BigDecimal` keeps the trailing zeros it was given, and they say how
    well the value is known and not what it is. The direct answers weigh a
    correction against the last place that carries a digit, so `1.000...0E-500`
    is answered exactly as `1E-500` is. Reading the thousandth zero as the
    last place instead asked for a correction a thousand times smaller than
    it needs to be, turned the argument away, and left it to a loop that
    cannot answer it: `sin` and `expm1` of this value both raised.
    """
    var text = String("1.")
    for _ in range(999):
        text += "0"
    text += "E-500"
    var padded = BigDecimal.from_string(text)
    var plain = BigDecimal.from_string("1E-500")
    assert_equal(padded.number_of_digits(), 1000, "the zeros are kept")

    for which in range(_FUNCTIONS):
        for mode in _modes():
            assert_equal(
                String(_applied(which, padded, 20, mode)),
                String(_applied(which, plain, 20, mode)),
                String("function ") + String(which) + ", " + String(mode),
            )
