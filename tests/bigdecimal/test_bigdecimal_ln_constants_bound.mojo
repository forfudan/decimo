"""
Pins the error bound of the ln(2) and ln(1.25) series.

Each term is rounded down to the working precision, and the recurrence
divides by an exact integer rather than multiplying by a truncated square, so
the errors do not compound: truncation of the terms is below `1.125` units
in the last place, the initial `1/3` (or `1/9`) enters through the first term
only for another unit, the stopping rule leaves a tail below `1.2` units,
and the final round-down is one more. The total is below `4.5 * 10^-p`, at
every precision `p` -- at most the last digit is off. `MathCache` relies on
that with its nine guard digits.

Two thousand digits is past the 1100-digit tables, so the series really
runs. The references are CPython's `decimal` at 2100 digits, truncated to
2010; the differences are taken at full width with `subtract()` because the
`-` operator rounds to 28 digits.
"""

from std import testing
from std.testing import assert_true

from decimo.bigdecimal.bigdecimal import BDec
from decimo.bigdecimal.arithmetics import subtract
from decimo.bigdecimal.exponential import compute_ln2, compute_ln1d25

