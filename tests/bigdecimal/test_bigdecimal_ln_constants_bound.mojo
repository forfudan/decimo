def assert_within_bound(computed: BDec, reference: String, name: String) raises:
    var error = subtract(BDec(reference), computed)
    error.sign = False
    assert_true(
        error < BDec("4.5E-2000"),
        name + " is off by more than 4.5 units in the last place",
    )
    # And the answer is not simply short.
    assert_true(
        computed.number_of_digits() >= 2000, name + " has too few digits"
    )


def test_ln2_at_two_thousand_digits() raises:
    assert_within_bound(compute_ln2(2000), LN2_2010, "compute_ln2(2000)")


def test_ln1d25_at_two_thousand_digits() raises:
    assert_within_bound(
        compute_ln1d25(2000), LN1D25_2010, "compute_ln1d25(2000)"
    )


def main() raises:
    testing.TestSuite.discover_tests[__functions_in_module()]().run()
